# === Public Frontend Variables (Vite — exposed to browser) ===
# Copy this file to .env.local for local frontend development.
VITE_DB_URL=<your-supabase-project-url>
VITE_DB_ANON_KEY=<your-supabase-anon-key>

# === Local Development Mocks ===
# Set to "true" to use mock data instead of a real Supabase connection.
# Perfect for visual inspection of auth‑gated pages without a running Supabase
# instance. Creates a fake authenticated session, workshop, subscription,
# materials, quotes, and clients.
# VITE_USE_LOCAL_MOCKS=true

# Optional: frontend observability/support (safe browser-exposed values)
VITE_SENTRY_DSN=
VITE_SUPPORT_EMAIL=

# === E2E Testing ===
# Required for admin E2E tests (admin/*.spec.ts). Without these, credential-
# dependent admin specs skip gracefully. The dev servers (chromium project) need
# a real Supabase backend seeded with these credentials; the mock/visual-snapshot
# projects use VITE_MOCK_ADMIN, VITE_USE_LOCAL_MOCKS instead.
# E2E_ADMIN_EMAIL=<your-admin-email>
# E2E_ADMIN_PASSWORD=<your-admin-password>

# === Server-Only Secrets ===
# DO NOT add these to .env.local or Vercel frontend env.
# Store these in Supabase Edge Function secrets instead:
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY
#   MERCADOPAGO_ACCESS_TOKEN
#   MERCADOPAGO_WEBHOOK_SECRET
#   APP_ORIGIN
#   MERCADOPAGO_SANDBOX_PAYER_EMAIL
